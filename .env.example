# Leave unset for a non-indexable foundation preview.
# Set only after domain approval. No placeholder production domain is assumed.
SITE_URL=
# Keep false until all launch content and checks are approved.
SITE_INDEXABLE=false
# Internal development demo only. Keep disabled on public deployments.
MOTION_LAB_ENABLED=false

# Candidate cases stay unpublished until attribution and permission are approved.

# Minimal contact email endpoint only. No database, SMTP server or CMS.
# Recipient stays private; never use NEXT_PUBLIC_ for these values.
CONTACT_EMAIL=
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_ORIGIN=
CONTACT_DELIVERY_ENABLED=false
# Only true behind a proxy that strips/replaces incoming X-Forwarded-For.
# In-process quotas are best effort, not distributed serverless protection.
CONTACT_TRUST_PROXY=false
