{
  "name": "motekra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "test:motion": "playwright test --config=playwright.motion.config.ts",
    "test:home": "playwright test --config=playwright.home.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postinstall": "node scripts/patch-opennext.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && wrangler dev",
    "deploy:worker": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
    "test:work": "playwright test --config=playwright.work.config.ts",
    "test:services": "playwright test --config=playwright.services.config.ts",
    "test:about": "playwright test --config=playwright.about.config.ts",
    "test:contact": "playwright test --config=playwright.contact.config.ts",
    "test:contact-delivery": "vitest run tests/unit/contact.test.ts",
    "test:seo": "playwright test --config=playwright.seo.config.ts",
    "test:quality": "playwright test --config=playwright.quality.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.5.0",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "~6.0.0",
    "vitest": "latest",
    "wrangler": "^4.155.0"
  }
}
